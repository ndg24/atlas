# Coordinator base URL the server-side proxy forwards requests to.
ATLAS_COORDINATOR_URL=http://localhost:8080

# Bearer token forwarded to the coordinator on every proxied request.
# There is no login flow yet -- mint a dev token with:
#   JWT_SECRET=<same secret the coordinator is running with> \
#     go run ./coordinator/cmd/tokengen -user-id dev-user -workspace-id 00000000-0000-0000-0000-000000000001 -ttl 24h
ATLAS_TOKEN=
