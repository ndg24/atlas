# Coordinator base URL the server-side proxy forwards requests to.
ATLAS_COORDINATOR_URL=http://localhost:8080

# Bearer token forwarded to the coordinator on every proxied request, used
# only as a fallback for requests with no logged-in session cookie (e.g.
# scripts, CI, or before you've visited /login). Log in through the
# dashboard at /login for normal use -- it signs up or logs in against the
# coordinator's POST /auth/signup or /auth/login and stores the resulting
# token in an httpOnly cookie, no env var needed. This is only worth setting
# if you want a token that isn't tied to any one browser session:
#   JWT_SECRET=<same secret the coordinator is running with> \
#     go run ./coordinator/cmd/tokengen -user-id dev-user -workspace-id 00000000-0000-0000-0000-000000000001 -ttl 24h
ATLAS_TOKEN=
